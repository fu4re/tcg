// Control spec (Track P0.5b, discriminator): a getter claim asserting the
// WRONG stored slot must NOT prove. This is the mandatory non-vacuity check
// for the return-value equality itself (docs/findings/0003b): if the wedge
// were somehow being discharged for a reason unrelated to the actual
// return-value binding (e.g. a typo that trivializes the antecedent, or a
// lemma set so aggressive it collapses distinct symbolic Map lookups), a
// WRONG-slot claim would also prove, and the "real Accept" on the correct
// claims would be worthless. It must not.
//
// Each module below is a byte-for-byte copy of the corresponding real,
// Accepted claim in tests/reference/getters-full/src/<name>/<name>.k --
// SAME program, SAME calldata (SAME selector -- this is still a call to
// vat()/ilk()/gem()), SAME symbolic caller/id range, SAME storage-frame --
// with exactly one change: the `ensures` return-value equality names a
// DIFFERENT storage slot than the one the getter body actually reads.
//   vat()  actually reads slot 1 -- this claims slot 2 (ilk's slot)
//   ilk()  actually reads slot 2 -- this claims slot 3 (gem's slot)
//   gem()  actually reads slot 3 -- this claims slot 1 (vat's slot)
// STORAGE is a single fully-symbolic Map with no relation asserted between
// two different keys' values, so #lookup(STORAGE, i) and #lookup(STORAGE, j)
// (i =/= j) are independent symbolic Ints; no simplification lemma in the
// vendored set (docs/findings/0004) relates them. The residual equality
// between the getter's actual (correctly-reduced) return value and the wrong
// slot's value should therefore be UNDECIDABLE from the claim's antecedent
// alone -- expected verdict: NOT Accept (Unknown(c) or Refute), never #Top.
//
// Run each (module name matches the claim label below):
//   kprove tests/control/getters-full/wrong-slot.k \
//     --definition ~/toolchains/kevm-1.0.678-lemmas/haskell \
//     --spec-module WRONG-SLOT-<VAT|ILK|GEM>-SPEC \
//     -I ~/toolchains/kevm-1.0.678-lemmas/evm-semantics-source \
//     -I ~/toolchains/kevm-1.0.678-lemmas/plugin
// Expected for every module: NOT Accept.

requires "edsl.md"

// vat() actually returns #buf(32, #lookup(STORAGE,1) &Int maxUInt160) (real
// claim: tests/reference/getters-full/src/vat/vat.k, Accept). This module
// instead claims slot 2 (ilk's slot).
module WRONG-SLOT-VAT-SPEC
    imports EDSL

    claim
      <kevm>
        <k> #execute => #halt </k>
        <mode> NORMAL </mode>
        <schedule> SHANGHAI </schedule>
        <useGas> false </useGas>
        <ethereum>
          <evm>
            <output> _ => ?OUT:Bytes </output>
            <statusCode> _ => ?SC:StatusCode </statusCode>
            <callStack> .List </callStack>
            <callState>
              <program> #parseByteStack("") </program>
              <jumpDests> #computeValidJumpDests(#parseByteStack("")) </jumpDests>
              <id> ACCTID:Int </id>
              <caller> MSGSENDER:Int </caller>
              <callData> b"\x36\x56\x9e\x77" </callData>
              <callValue> 0 </callValue>
              <wordStack> .WordStack => ?_ </wordStack>
              <localMem> .Bytes => ?_ </localMem>
              <pc> 0 => ?_ </pc>
              <memoryUsed> 0 => ?_ </memoryUsed>
              <static> false </static>
              ...
            </callState>
            ...
          </evm>
          <network>
            <accounts>
              <account>
                <acctID> ACCTID:Int </acctID>
                <storage> STORAGE:Map </storage>
                ...
              </account>
              ...
            </accounts>
            ...
          </network>
          ...
        </ethereum>
        ...
      </kevm>
      requires 0 <=Int ACCTID andBool ACCTID <Int (2 ^Int 160)
       andBool 0 <=Int MSGSENDER andBool MSGSENDER <Int (2 ^Int 160)
       andBool #rangeUInt(256, #lookup(STORAGE, 1))
       andBool #rangeUInt(256, #lookup(STORAGE, 2))
      ensures ?SC ==K EVMC_SUCCESS
       andBool ?OUT ==K #buf(32, #lookup(STORAGE, 2) &Int maxUInt160)
     [label(vat-wrong-slot), all-path]

endmodule

// ilk() actually returns #buf(32, #lookup(STORAGE,2)) (real claim:
// tests/reference/getters-full/src/ilk/ilk.k, Accept). This module instead
// claims slot 3 (gem's slot).
module WRONG-SLOT-ILK-SPEC
    imports EDSL

    claim
      <kevm>
        <k> #execute => #halt </k>
        <mode> NORMAL </mode>
        <schedule> SHANGHAI </schedule>
        <useGas> false </useGas>
        <ethereum>
          <evm>
            <output> _ => ?OUT:Bytes </output>
            <statusCode> _ => ?SC:StatusCode </statusCode>
            <callStack> .List </callStack>
            <callState>
              <program> #parseByteStack("") </program>
              <jumpDests> #computeValidJumpDests(#parseByteStack("")) </jumpDests>
              <id> ACCTID:Int </id>
              <caller> MSGSENDER:Int </caller>
              <callData> b"\xc5\xce\x28\x1e" </callData>
              <callValue> 0 </callValue>
              <wordStack> .WordStack => ?_ </wordStack>
              <localMem> .Bytes => ?_ </localMem>
              <pc> 0 => ?_ </pc>
              <memoryUsed> 0 => ?_ </memoryUsed>
              <static> false </static>
              ...
            </callState>
            ...
          </evm>
          <network>
            <accounts>
              <account>
                <acctID> ACCTID:Int </acctID>
                <storage> STORAGE:Map </storage>
                ...
              </account>
              ...
            </accounts>
            ...
          </network>
          ...
        </ethereum>
        ...
      </kevm>
      requires 0 <=Int ACCTID andBool ACCTID <Int (2 ^Int 160)
       andBool 0 <=Int MSGSENDER andBool MSGSENDER <Int (2 ^Int 160)
       andBool #rangeUInt(256, #lookup(STORAGE, 2))
       andBool #rangeUInt(256, #lookup(STORAGE, 3))
      ensures ?SC ==K EVMC_SUCCESS
       andBool ?OUT ==K #buf(32, #lookup(STORAGE, 3))
     [label(ilk-wrong-slot), all-path]

endmodule

// gem() actually returns #buf(32, #lookup(STORAGE,3) &Int maxUInt160) (real
// claim: tests/reference/getters-full/src/gem/gem.k, Accept). This module
// instead claims slot 1 (vat's slot).
module WRONG-SLOT-GEM-SPEC
    imports EDSL

    claim
      <kevm>
        <k> #execute => #halt </k>
        <mode> NORMAL </mode>
        <schedule> SHANGHAI </schedule>
        <useGas> false </useGas>
        <ethereum>
          <evm>
            <output> _ => ?OUT:Bytes </output>
            <statusCode> _ => ?SC:StatusCode </statusCode>
            <callStack> .List </callStack>
            <callState>
              <program> #parseByteStack("") </program>
              <jumpDests> #computeValidJumpDests(#parseByteStack("")) </jumpDests>
              <id> ACCTID:Int </id>
              <caller> MSGSENDER:Int </caller>
              <callData> b"\x7b\xd2\xbe\xa7" </callData>
              <callValue> 0 </callValue>
              <wordStack> .WordStack => ?_ </wordStack>
              <localMem> .Bytes => ?_ </localMem>
              <pc> 0 => ?_ </pc>
              <memoryUsed> 0 => ?_ </memoryUsed>
              <static> false </static>
              ...
            </callState>
            ...
          </evm>
          <network>
            <accounts>
              <account>
                <acctID> ACCTID:Int </acctID>
                <storage> STORAGE:Map </storage>
                ...
              </account>
              ...
            </accounts>
            ...
          </network>
          ...
        </ethereum>
        ...
      </kevm>
      requires 0 <=Int ACCTID andBool ACCTID <Int (2 ^Int 160)
       andBool 0 <=Int MSGSENDER andBool MSGSENDER <Int (2 ^Int 160)
       andBool #rangeUInt(256, #lookup(STORAGE, 3))
       andBool #rangeUInt(256, #lookup(STORAGE, 1))
      ensures ?SC ==K EVMC_SUCCESS
       andBool ?OUT ==K #buf(32, #lookup(STORAGE, 1) &Int maxUInt160)
     [label(gem-wrong-slot), all-path]

endmodule
