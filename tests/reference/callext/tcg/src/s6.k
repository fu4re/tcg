claim [s]:
    <k> #execute => #halt ... </k>
    <mode> NORMAL </mode>
    <schedule> DEFAULT </schedule>
    <useGas> false </useGas>
    <statusCode> _ => EVMC_SUCCESS </statusCode>
    <program> _PGM </program>
    <id> 200 </id>
    <caller> 100 </caller>
    <callData> .Bytes </callData>
    <callValue> 0 </callValue>
    <pc> 0 </pc>
    <wordStack> .WordStack </wordStack>
    <localMem> .Bytes </localMem>
    <static> false </static>
    <account>
      <acctID> 200 </acctID>
      <storage> 0 |-> 100 => 0 |-> 106 </storage>
      ...
    </account>
 [label(s), all-path]
