#!/usr/bin/env python3
"""Fake `lake`: `build` fails iff some .lean file contains "FAKE-BUILD-FAIL";
`env <lean> <file>` runs <lean> <file>. Not a kernel."""
import os
import subprocess
import sys

if sys.argv[1:2] == ["build"]:
    for dp, _, fs in os.walk("."):
        for f in fs:
            if f.endswith(".lean") and "FAKE-BUILD-FAIL" in open(os.path.join(dp, f)).read():
                print("error: fake build failure")
                sys.exit(1)
    print("Build completed successfully.")
    sys.exit(0)
if sys.argv[1:2] == ["env"]:
    sys.exit(subprocess.call(sys.argv[2:]))
sys.exit(64)
