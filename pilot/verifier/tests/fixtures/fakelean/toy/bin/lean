#!/usr/bin/env python3
"""Fake `lean` for verifier tests. Given TcgAxiomCheck.lean, prints what
`#print axioms` would print, driven by markers in the imported module's source:
  "-- FAKE-AXIOMS: a, b"  -> 'thm' depends on axioms: [a, b]
  no marker               -> 'thm' does not depend on any axioms
This exercises the verifier's parsing and whitelist logic only, NOT a kernel."""
import os
import re
import sys

src = open(sys.argv[-1]).read()
mod = re.search(r"^import (\S+)", src, re.M).group(1)
thm = re.search(r"^#print axioms (\S+)", src, re.M).group(1)
text = open(os.path.join(os.getcwd(), *mod.split(".")) + ".lean").read()
m = re.search(r"-- FAKE-AXIOMS: (.*)", text)
if m:
    print(f"'{thm}' depends on axioms: [{m.group(1).strip()}]")
else:
    print(f"'{thm}' does not depend on any axioms")
