{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sheaf.local/tcg/pilot/manifest.schema.json",
  "title": "tcg-bundle/0.1 manifest",
  "description": "Root of the bundle's Merkle DAG (TCG v3 section 4; pilot DECISIONS D1, D2, D3, D10, D11). Carries no verdict of any kind. Rules a JSON Schema cannot express (root_hash recomputation, unique paths, forbidden keys at any depth, claim/certificate pairing against trusted_base.json, child hashes on disk) are enforced by pilot/tools/lint_manifest.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "domain",
    "root_hash",
    "producer_sig",
    "self_contained",
    "children",
    "not_claimed"
  ],
  "properties": {
    "format": {
      "const": "tcg-bundle/0.1"
    },
    "domain": {
      "const": "evm-bytecode"
    },
    "root_hash": {
      "$ref": "#/$defs/sha256"
    },
    "producer_sig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "pubkey",
        "sig"
      ],
      "properties": {
        "alg": {
          "const": "ed25519"
        },
        "pubkey": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "raw 32-byte ed25519 public key, lowercase hex"
        },
        "sig": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$",
          "description": "raw 64-byte ed25519 signature over the ASCII hex of root_hash, lowercase hex"
        }
      }
    },
    "self_contained": {
      "type": "boolean"
    },
    "self_contained_reason": {
      "type": "string",
      "minLength": 1
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/child"
      },
      "allOf": [
        {
          "contains": {
            "$ref": "#/$defs/role_b"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "$ref": "#/$defs/role_phi"
          },
          "minContains": 1
        },
        {
          "contains": {
            "$ref": "#/$defs/role_a"
          },
          "minContains": 1
        },
        {
          "contains": {
            "$ref": "#/$defs/role_T_hat"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "$ref": "#/$defs/role_checker"
          },
          "minContains": 1
        }
      ]
    },
    "not_claimed": {
      "description": "The five sentences of TCG v3 section 10 'What the bundle does not claim', verbatim, in order (D11).",
      "const": [
        "It does not claim the artifact is secure, only that it satisfies φ.",
        "It does not claim φ is complete.",
        "It does not claim the generator is good, or that its reasoning was sound, or that its traces are faithful.",
        "It does not claim economic or game-theoretic properties of the system the artifact participates in.",
        "It does not claim anything about an artifact whose identity differs from id(b) by one byte."
      ]
    }
  },
  "if": {
    "properties": {
      "self_contained": {
        "const": false
      }
    }
  },
  "then": {
    "required": [
      "self_contained_reason"
    ]
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hash",
        "class",
        "media",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))(?!.*//)[A-Za-z0-9._/+-]+$",
          "description": "bundle-relative, '/'-separated, no '.', '..', empty or absolute segments"
        },
        "hash": {
          "$ref": "#/$defs/sha256"
        },
        "class": {
          "enum": [
            "U",
            "T",
            "T*"
          ]
        },
        "media": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "b",
            "phi",
            "a",
            "c",
            "T_hat",
            "V",
            "P",
            "checker"
          ]
        },
        "claim": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$",
          "description": "claim id: on each claim's phi file, on every rediscuss invocation, on every Lean certificate (with 'theorem'). Lean project support files (role c) carry none."
        },
        "theorem": {
          "type": "string",
          "minLength": 1,
          "description": "fully qualified Lean theorem name. Only a role-c text/x-lean child with a theorem is a proof object (rule 2)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "enum": [
                  "b",
                  "phi",
                  "a",
                  "c",
                  "T_hat",
                  "checker"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "class": {
                "const": "T"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "V"
              }
            }
          },
          "then": {
            "properties": {
              "class": {
                "const": "T*"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "P"
              }
            }
          },
          "then": {
            "properties": {
              "class": {
                "const": "U"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "role",
              "media"
            ],
            "properties": {
              "role": {
                "const": "c"
              },
              "media": {
                "const": "application/vnd.tcg.rediscuss+json"
              }
            }
          },
          "then": {
            "required": [
              "claim"
            ]
          }
        },
        {
          "if": {
            "required": [
              "theorem"
            ]
          },
          "then": {
            "required": [
              "claim"
            ],
            "properties": {
              "role": {
                "const": "c"
              },
              "media": {
                "const": "text/x-lean"
              }
            }
          }
        }
      ]
    },
    "role_b": {
      "type": "object",
      "properties": {
        "role": {
          "const": "b"
        }
      },
      "required": [
        "role"
      ]
    },
    "role_phi": {
      "type": "object",
      "properties": {
        "role": {
          "const": "phi"
        }
      },
      "required": [
        "role"
      ]
    },
    "role_a": {
      "type": "object",
      "properties": {
        "role": {
          "const": "a"
        }
      },
      "required": [
        "role"
      ]
    },
    "role_T_hat": {
      "type": "object",
      "properties": {
        "role": {
          "const": "T_hat"
        }
      },
      "required": [
        "role"
      ]
    },
    "role_checker": {
      "type": "object",
      "properties": {
        "role": {
          "const": "checker"
        }
      },
      "required": [
        "role"
      ]
    }
  }
}
