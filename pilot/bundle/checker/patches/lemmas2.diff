@@ -0,0 +1,38 @@
+// map-simplification.k -- the #lookup MAP-REASONING [simplification] lemmas of
+// KEVM, extracted VERBATIM from evm-semantics lemmas/lemmas.k so the
+// lemmas-driver can carry them WITHOUT importing module
+// LEMMAS-WITHOUT-SLOT-UPDATES wholesale (see bool2word-simplification.k for why:
+// that module also holds the non-simplification #addrFromPrivateKey concrete
+// rewrite, lemmas.k:137).
+//
+// Needed by the two-slot token legs (WETH transferFrom/transfer, GemJoin
+// join/exit): they write TWO balanceOf/gem slots, and the second balanceOf read
+// `#lookup(STORAGE[K_src <- _], K_dst)` (distinct concrete keys) must reduce via
+// the lookup-over-update rule to `#lookup(STORAGE, K_dst)` so the outer
+// `chop(_ +Int wad)` can strip against the no-overflow precondition. Vat.slip's
+// single SSTORE never exercised this; it is new to the multi-slot legs.
+//
+// PROVENANCE (verbatim): every rule below is copied character-for-character from
+// evm-semantics lemmas/lemmas.k, module LEMMAS-WITHOUT-SLOT-UPDATES, the "Map
+// Reasoning" section, lemmas.k lines 125-130. Cross-checked byte-identical
+// against the WETH callee-proof agent's independently-extracted lemmas_min.k
+// (family B). #lookup / pow256 are defined in evm-types.md (EVM-TYPES); imports
+// mirror bool2word-simplification.k.
+requires "word.md"
+
+module MAP-REASONING-SIMPLIFICATION [symbolic]
+    imports EVM-TYPES
+    imports INT-SYMBOLIC
+    imports WORD
+
+  // ########################
+  // Map Reasoning
+  // ########################
+
+    rule 0 <=Int #lookup( _M:Map , _ )             => true [simplification, smt-lemma]
+    rule         #lookup( _M:Map , _ ) <Int pow256 => true [simplification, smt-lemma]
+
+    rule #lookup ( _M:Map [ K1 <- V1 ] , K2 )    => #lookup ( K1 |-> V1 , K1 ) requires K1 ==Int  K2 [simplification]
+    rule #lookup (  M:Map [ K1 <- _  ] , K2 )    => #lookup ( M         , K2 ) requires notBool ( K1 ==Int K2 ) [simplification]
+    rule #lookup ( (K1:Int |-> _) M:Map, K2:Int) => #lookup ( M         , K2 ) requires notBool ( K1 ==Int K2 ) [simplification]
+endmodule
